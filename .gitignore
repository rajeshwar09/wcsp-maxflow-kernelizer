# .gitignore
# build output, local data and results never go to git

# [BUILD] programs made by scripts/build.sh
/e2e_solve
/e2e_solve_gpu
/mincut_lattice
/wcsp_collapse
/kmf_test
/cut_audit
/compare_kernels
/compare_kernels_gpu
*.o
build/
third_party/**/build/
third_party/cuda

# [DATA] instance folders and generated benchmarks, they are large
/instances/
data/wcsp/*.wcsp
data/bench/*

# [RESULTS] every script writes into results/<date>/, kept only on the local machine
results/
*.xlsx

# [EDITOR] editor and system files
.vscode/
.DS_Store

# [PYTHON] cache folder made when one script imports another
__pycache__/
